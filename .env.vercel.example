# ============================================================
# SiMatRPS — contoh Environment Variables untuk Vercel
# JANGAN commit nilai API key/password asli.
# ============================================================

APP_NAME=SiMatRPS
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:PASTE_HASIL_php_artisan_key_generate_show
APP_URL=https://simatrps.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Serverless-safe defaults
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# ------------------------------------------------------------
# DATABASE ONLINE — Supabase Supavisor Transaction Pooler
# Runtime Vercel gunakan Shared Pooler port 6543.
# Migration dapat dijalankan terpisah memakai Session Pooler 5432.
# ------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=YOUR_SUPABASE_POOLER_HOST
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DB_PASSWORD
DB_SSLMODE=require
DB_EMULATE_PREPARES=true

# ------------------------------------------------------------
# SSO — SiMatRPS bertindak sebagai identity provider.
# Authorization Code + PKCE, tanpa password/client secret di browser.
# ------------------------------------------------------------
SSO_ISSUER_URL=https://simatrps.vercel.app
SSO_SIPANDU_REDIRECT_URI=https://sipandumath.vercel.app/sso/callback

# ------------------------------------------------------------
# AI PROVIDER CHAIN
# Hanya provider dengan API key valid yang akan dipakai.
# ------------------------------------------------------------
SIMATRPS_AI_PROVIDER=groq
SIMATRPS_AI_PROVIDER_CHAIN=groq,mistral,sambanova,openrouter,huggingface,cohere

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

HF_TOKEN=
HF_MODEL=Qwen/Qwen3-4B-Thinking-2507:fastest

COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026

# Optional / tidak masuk chain default
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
