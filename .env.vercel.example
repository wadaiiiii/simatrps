# ============================================================
# SiMatRPS — contoh Environment Variables untuk Vercel
# JANGAN commit nilai API key/password asli.
# ============================================================

APP_NAME=SiMatRPS
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:PASTE_HASIL_php_artisan_key_generate_show
APP_URL=https://NAMA-PROJECT.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Serverless-safe defaults
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# ------------------------------------------------------------
# DATABASE ONLINE
# Gunakan PostgreSQL online: Supabase / Neon / provider SQL Anda.
# ------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=YOUR_DB_HOST
DB_PORT=5432
DB_DATABASE=YOUR_DB_NAME
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_SSLMODE=require

# ------------------------------------------------------------
# AI PROVIDER CHAIN
# Hanya provider dengan API key valid yang akan dipakai.
# ------------------------------------------------------------
SIMATRPS_AI_PROVIDER_CHAIN=groq,mistral,openrouter,sambanova,huggingface,cohere

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

OPENROUTER_API_KEY=
OPENROUTER_MODEL=poolside/laguna-xs-2.1:free

SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct-8k

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=

COHERE_API_KEY=
COHERE_MODEL=

# Optional
GEMINI_API_KEY=
