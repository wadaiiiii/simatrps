{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "regions": [
    "hnd1"
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- app api bootstrap config database public resources routes composer.json composer.lock package.json package-lock.json vite.config.js vite.config.ts tsconfig.json vercel.json artisan",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 60
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "public/build",
  "routes": [
    {
      "src": "/logo-unsulbar.png",
      "dest": "/api/logo.php"
    },
    {
      "src": "/__health",
      "dest": "/api/health.php"
    },
    {
      "src": "/__laravel-health",
      "dest": "/api/laravel-health.php"
    },
    {
      "src": "/build/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
